# NOMA — Namangan Fashion Marketplace
# Copy to .env.local for local development and add all variables to Vercel Project Settings.

# Brand & Localization (configurable)
NEXT_PUBLIC_APP_NAME=NOMA
NEXT_PUBLIC_DEFAULT_CITY=Namangan
NEXT_PUBLIC_CURRENCY=UZS
NEXT_PUBLIC_TIMEZONE=Asia/Tashkent
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Access (comma-separated Google emails allowed into /admin)
ADMIN_EMAILS=

# Telegram Bots (Customer, Seller, Admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_SELLER_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
SELLER_CODE_EXPIRY_HOURS=24
CODE_HASH_PEPPER=

# Auth Provider Flags (set to "true" once enabled in Supabase Dashboard -> Auth -> Providers)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
NEXT_PUBLIC_AUTH_SMS_ENABLED=false

# Optional: Eskiz.uz SMS Gateway (if using Eskiz instead of Supabase native Phone Auth)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
